# PostgreSQL — required for staff authentication and administration
DATABASE_URL=postgresql://greenscope:change-me@localhost:5432/greenscope
DATABASE_SSL=false
DB_POOL_MAX=10

# Session and authentication
NODE_ENV=development
SESSION_COOKIE_NAME=greenscope.sid
SESSION_TTL_HOURS=12
LOGIN_ATTEMPTS_PER_WINDOW=10
CORS_ORIGINS=http://localhost:5173

# One-time bootstrap only. Use unique local values; never commit a real .env.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Reserved for a future real environmental-analysis provider; never expose in the browser.
LLM_PROVIDER=
LLM_API_KEY=
